rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'essadhiif@gmail.com';
    }

    function isValidPlan(plan) {
      return plan is string && plan in ['bootstrap', 'accelerate', 'pro_agency', 'lifetime', 'pro50', 'pro100', 'pro150'];
    }

    function isValidTeamRole(role) {
      return role is string && role in ['Owner', 'Admin', 'Editor', 'Client Approver', 'Manager', 'Publisher', 'Contributor'];
    }

    function isBoundedMapList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is map);
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isValidAcademyCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'description', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'order', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.description is string && data.description.size() <= 400
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAcademyTutorial(data) {
      return data.keys().hasAll([
          'id', 'videoId', 'youtubeUrl', 'title', 'shortDescription', 'fullDescription',
          'thumbnailUrl', 'duration', 'categoryId', 'keywords', 'learningObjectives',
          'steps', 'tips', 'order', 'published', 'publishedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'videoId', 'youtubeUrl', 'title', 'shortDescription', 'fullDescription',
          'thumbnailUrl', 'duration', 'categoryId', 'keywords', 'learningObjectives',
          'steps', 'tips', 'order', 'published', 'featured', 'publishedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.videoId is string && data.videoId.matches('^[a-zA-Z0-9_\\-]{11}$')
        && data.youtubeUrl is string && data.youtubeUrl.size() >= 10 && data.youtubeUrl.size() <= 512
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.shortDescription is string && data.shortDescription.size() <= 500
        && data.fullDescription is string && data.fullDescription.size() <= 8000
        && data.thumbnailUrl is string && data.thumbnailUrl.size() <= 512
        && data.duration is string && data.duration.size() <= 24
        && isValidId(data.categoryId)
        && isBoundedStringList(data.keywords, 30)
        && isBoundedStringList(data.learningObjectives, 20)
        && isBoundedMapList(data.steps, 40)
        && isBoundedStringList(data.tips, 20)
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.published is bool
        && (!('featured' in data) || data.featured is bool)
        && data.publishedAt is string && data.publishedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAcademyProgress(data) {
      return data.keys().hasAll([
          'userId', 'completedTutorialIds', 'watchedTutorialIds', 'recentTutorialIds',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'completedTutorialIds', 'watchedTutorialIds', 'recentTutorialIds',
          'lastWatchedTutorialId', 'lastWatchedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isAdmin())
        && isBoundedStringList(data.completedTutorialIds, 500)
        && isBoundedStringList(data.watchedTutorialIds, 500)
        && isBoundedStringList(data.recentTutorialIds, 50)
        && (!('lastWatchedTutorialId' in data) || data.lastWatchedTutorialId == null || isValidId(data.lastWatchedTutorialId))
        && (!('lastWatchedAt' in data) || data.lastWatchedAt == null || (data.lastWatchedAt is string && data.lastWatchedAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'selectedPlan', 'activeRole', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'selectedPlan', 'activeRole', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && (data.uid == request.auth.uid || isAdmin())
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (data.email == request.auth.token.email || isAdmin())
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('status' in data) || (data.status is string && data.status in ['active', 'suspended']))
        && isValidPlan(data.selectedPlan)
        && isValidTeamRole(data.activeRole)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceSnapshot(data) {
      return data.keys().hasAll([
          'ownerId', 'activeWorkspaceId', 'activeRole', 'selectedPlan', 'darkMode',
          'workspaces', 'categories', 'connectedProfiles', 'teamMembers', 'contacts',
          'threads', 'deals', 'posts', 'ads', 'drafts', 'discoveryAlerts',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'activeWorkspaceId', 'activeRole', 'selectedPlan', 'darkMode',
          'workspaces', 'categories', 'connectedProfiles', 'teamMembers', 'contacts',
          'threads', 'deals', 'posts', 'ads', 'drafts', 'discoveryAlerts',
          'youtubeChannels', 'youtubeVideos', 'seoArticles', 'cmsConnectors',
          'rssSources', 'curatedItems', 'ecommerceFeeds', 'viralCampaigns',
          'workspaceCredits', 'approvalAuditLogs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.activeWorkspaceId)
        && isValidTeamRole(data.activeRole)
        && isValidPlan(data.selectedPlan)
        && data.darkMode is bool
        && isBoundedMapList(data.workspaces, 25)
        && isBoundedMapList(data.categories, 50)
        && isBoundedMapList(data.connectedProfiles, 150)
        && isBoundedMapList(data.teamMembers, 50)
        && isBoundedMapList(data.contacts, 200)
        && isBoundedMapList(data.threads, 200)
        && isBoundedMapList(data.deals, 200)
        && isBoundedMapList(data.posts, 300)
        && isBoundedMapList(data.ads, 100)
        && isBoundedMapList(data.drafts, 200)
        && isBoundedMapList(data.discoveryAlerts, 100)
        && (!('youtubeChannels' in data) || isBoundedMapList(data.youtubeChannels, 100))
        && (!('youtubeVideos' in data) || isBoundedMapList(data.youtubeVideos, 200))
        && (!('seoArticles' in data) || isBoundedMapList(data.seoArticles, 150))
        && (!('cmsConnectors' in data) || isBoundedMapList(data.cmsConnectors, 50))
        && (!('rssSources' in data) || isBoundedMapList(data.rssSources, 150))
        && (!('curatedItems' in data) || isBoundedMapList(data.curatedItems, 200))
        && (!('ecommerceFeeds' in data) || isBoundedMapList(data.ecommerceFeeds, 50))
        && (!('viralCampaigns' in data) || isBoundedMapList(data.viralCampaigns, 100))
        && (!('workspaceCredits' in data) || data.workspaceCredits is map)
        && (!('approvalAuditLogs' in data) || isBoundedMapList(data.approvalAuditLogs, 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceMember(data) {
      return data.keys().hasAll(['id', 'ownerId', 'workspaceId', 'name', 'email', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'workspaceId', 'name', 'email', 'role', 'status', 'permissions', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.workspaceId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && isValidTeamRole(data.role)
        && data.status is string && data.status in ['active', 'invited']
        && (!('permissions' in data) || data.permissions is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSocialConnection(data) {
      return data.keys().hasAll(['id', 'ownerId', 'workspaceId', 'platform', 'accountName', 'handle', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'workspaceId', 'platform', 'accountName', 'handle', 'status', 'authMethod', 'followers', 'lastSynced', 'externalId', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isAdmin())
        && isValidId(data.workspaceId)
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 32
        && data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 160
        && data.handle is string && data.handle.size() >= 1 && data.handle.size() <= 160
        && data.status is string && data.status in ['connected', 'needs_reauth', 'disconnected']
        && (!('authMethod' in data) || (data.authMethod is string && data.authMethod in ['oauth2', 'app_password', 'manual']))
        && (!('followers' in data) || (data.followers is number && data.followers >= 0))
        && (!('lastSynced' in data) || (data.lastSynced is string && data.lastSynced.size() <= 80))
        && (!('externalId' in data) || (data.externalId is string && data.externalId.size() <= 160))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp;
    }

    function isValidPlatformAdminState(data) {
      return data.keys().hasAll([
          'updatedBy', 'tenants', 'featureFlags', 'auditLogs', 'apiHealthNodes',
          'aiGovernance', 'promoCodes', 'invoices', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'updatedBy', 'tenants', 'featureFlags', 'auditLogs', 'apiHealthNodes',
          'aiGovernance', 'promoCodes', 'invoices', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && isBoundedMapList(data.tenants, 200)
        && isBoundedMapList(data.featureFlags, 50)
        && isBoundedMapList(data.auditLogs, 200)
        && isBoundedMapList(data.apiHealthNodes, 30)
        && data.aiGovernance is map
        && isBoundedMapList(data.promoCodes, 100)
        && isBoundedMapList(data.invoices, 200)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlatformGovernanceConfig(data) {
      return data.keys().hasAll(['updatedBy', 'aiGovernance', 'featureFlags', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['updatedBy', 'aiGovernance', 'featureFlags', 'createdAt', 'updatedAt'])
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.aiGovernance is map
        && isBoundedMapList(data.featureFlags, 50)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection: /users/{userId} (PII Isolated)
    // =========================================================================
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isOwner(userId) || isAdmin());

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'selectedPlan', 'activeRole', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // =======================================================================
      // Subcollection: /users/{userId}/workspaces/{workspaceDocId} (Master Gate)
      // =======================================================================
      match /workspaces/{workspaceDocId} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(workspaceDocId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(workspaceDocId)
          && isValidWorkspaceSnapshot(incoming())
          && incoming().ownerId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(workspaceDocId)
          && isValidWorkspaceSnapshot(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && exists(/databases/$(database)/documents/users/$(userId))
              && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'activeWorkspaceId', 'activeRole', 'selectedPlan', 'darkMode',
                'workspaces', 'categories', 'connectedProfiles', 'teamMembers',
                'contacts', 'threads', 'deals', 'posts', 'ads', 'drafts',
                'discoveryAlerts', 'youtubeChannels', 'youtubeVideos',
                'seoArticles', 'cmsConnectors', 'rssSources', 'curatedItems',
                'ecommerceFeeds', 'viralCampaigns', 'workspaceCredits',
                'approvalAuditLogs', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(workspaceDocId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        // Subcollection: workspaceMembers
        match /workspaceMembers/{memberId} {
          allow get: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(workspaceDocId)
            && isValidId(memberId)
            && (isOwner(userId) || isAdmin())
            && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceDocId));

          allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());

          allow create: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(workspaceDocId)
            && isValidId(memberId)
            && isValidWorkspaceMember(incoming())
            && incoming().id == memberId
            && incoming().ownerId == userId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (isOwner(userId) || isAdmin())
            && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceDocId));

          allow update: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(workspaceDocId)
            && isValidId(memberId)
            && isValidWorkspaceMember(incoming())
            && incoming().id == existing().id
            && incoming().ownerId == existing().ownerId
            && incoming().workspaceId == existing().workspaceId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              isAdmin() ||
              (
                isOwner(userId)
                && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceDocId))
                && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'status', 'permissions', 'updatedAt'])
              )
            );

          allow delete: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(workspaceDocId)
            && isValidId(memberId)
            && (isOwner(userId) || isAdmin())
            && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceDocId));
        }

        // Subcollection: socialConnections
        match /socialConnections/{connectionId} {
          allow get: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(workspaceDocId)
            && isValidId(connectionId)
            && (isOwner(userId) || isAdmin())
            && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceDocId));

          allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());

          allow create: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(workspaceDocId)
            && isValidId(connectionId)
            && isValidSocialConnection(incoming())
            && incoming().id == connectionId
            && incoming().ownerId == userId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (isOwner(userId) || isAdmin())
            && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceDocId));

          allow update: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(workspaceDocId)
            && isValidId(connectionId)
            && isValidSocialConnection(incoming())
            && incoming().id == existing().id
            && incoming().ownerId == existing().ownerId
            && incoming().workspaceId == existing().workspaceId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              isAdmin() ||
              (
                isOwner(userId)
                && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceDocId))
                && incoming().diff(existing()).affectedKeys().hasOnly(['accountName', 'handle', 'status', 'authMethod', 'followers', 'lastSynced', 'externalId', 'updatedAt'])
              )
            );

          allow delete: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(workspaceDocId)
            && isValidId(connectionId)
            && (isOwner(userId) || isAdmin())
            && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceDocId));
        }
      }

      // =======================================================================
      // Subcollection: /users/{userId}/academyProgress/{progressDocId}
      // =======================================================================
      match /academyProgress/{progressDocId} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(progressDocId)
          && (isOwner(userId) || isAdmin());

        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(progressDocId)
          && isValidAcademyProgress(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (isOwner(userId) || isAdmin());

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(progressDocId)
          && isValidAcademyProgress(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isOwner(userId) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'completedTutorialIds', 'watchedTutorialIds', 'recentTutorialIds',
            'lastWatchedTutorialId', 'lastWatchedAt', 'updatedAt'
          ]);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(progressDocId)
          && (isOwner(userId) || isAdmin());
      }
    }

    // =========================================================================
    // Collection: /admins/{adminId}
    // =========================================================================
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdminRole(incoming())
        && incoming().uid == adminId
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // =========================================================================
    // Collection: /adminState/{configId} (Super Admin Control Panel)
    // =========================================================================
    match /adminState/{configId} {
      allow get: if isVerifiedUser() && isValidId(configId) && isAdmin();
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(configId)
        && isValidPlatformAdminState(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(configId)
        && isValidPlatformAdminState(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'updatedBy', 'tenants', 'featureFlags', 'auditLogs', 'apiHealthNodes',
          'aiGovernance', 'promoCodes', 'invoices', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(configId);
    }

    // =========================================================================
    // Collection: /platformConfig/{configId} (Non-PII Global Quotas & Flags)
    // =========================================================================
    match /platformConfig/{configId} {
      allow get: if isVerifiedUser() && isValidId(configId);
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(configId)
        && isValidPlatformGovernanceConfig(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(configId)
        && isValidPlatformGovernanceConfig(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'updatedBy', 'aiGovernance', 'featureFlags', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(configId);
    }

    // =========================================================================
    // Collection: /academyCategories/{categoryId} (SocialifyAI Academy)
    // =========================================================================
    match /academyCategories/{categoryId} {
      allow get: if isVerifiedUser() && isValidId(categoryId);
      allow list: if isVerifiedUser();

      allow create: if isAdmin()
        && isValidId(categoryId)
        && isValidAcademyCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(categoryId)
        && isValidAcademyCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'description', 'order', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // =========================================================================
    // Collection: /academyTutorials/{tutorialId} (SocialifyAI Academy)
    // =========================================================================
    match /academyTutorials/{tutorialId} {
      allow get: if isVerifiedUser()
        && isValidId(tutorialId)
        && (resource.data.published == true || isAdmin());

      allow list: if isVerifiedUser()
        && (resource.data.published == true || isAdmin());

      allow create: if isAdmin()
        && isValidId(tutorialId)
        && isValidAcademyTutorial(incoming())
        && incoming().id == tutorialId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(tutorialId)
        && isValidAcademyTutorial(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'videoId', 'youtubeUrl', 'title', 'shortDescription', 'fullDescription',
          'thumbnailUrl', 'duration', 'categoryId', 'keywords', 'learningObjectives',
          'steps', 'tips', 'order', 'published', 'featured', 'publishedAt', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(tutorialId);
    }
  }
}
