{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile for socialifyai.com",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "maxLength": 2048
        },
        "selectedPlan": {
          "type": "string",
          "enum": ["bootstrap", "accelerate", "pro_agency", "lifetime", "pro50", "pro100", "pro150"]
        },
        "activeRole": {
          "type": "string",
          "enum": ["Owner", "Admin", "Editor", "Client Approver", "Manager", "Publisher", "Contributor"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "selectedPlan", "activeRole", "createdAt", "updatedAt"]
    },
    "WorkspaceSnapshot": {
      "title": "WorkspaceSnapshot",
      "description": "Cloud-synced social media management, YouTube, AI SEO, RSS discovery, viral campaigns & Social CRM workspace state owned by a user",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "activeWorkspaceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "activeRole": {
          "type": "string",
          "enum": ["Owner", "Admin", "Editor", "Client Approver", "Manager", "Publisher", "Contributor"]
        },
        "selectedPlan": {
          "type": "string",
          "enum": ["bootstrap", "accelerate", "pro_agency", "lifetime", "pro50", "pro100", "pro150"]
        },
        "darkMode": {
          "type": "boolean"
        },
        "workspaces": {
          "type": "array",
          "description": "Brand workspaces (max 25)"
        },
        "categories": {
          "type": "array",
          "description": "Evergreen content categories (max 50)"
        },
        "connectedProfiles": {
          "type": "array",
          "description": "Connected social profiles (max 150)"
        },
        "teamMembers": {
          "type": "array",
          "description": "Workspace team members (max 50)"
        },
        "contacts": {
          "type": "array",
          "description": "Social CRM contacts (max 200)"
        },
        "threads": {
          "type": "array",
          "description": "Unified inbox threads (max 200)"
        },
        "deals": {
          "type": "array",
          "description": "CRM pipeline deals (max 200)"
        },
        "posts": {
          "type": "array",
          "description": "Scheduled and published posts (max 300)"
        },
        "ads": {
          "type": "array",
          "description": "Cross-platform ad campaigns (max 100)"
        },
        "drafts": {
          "type": "array",
          "description": "Saved studio drafts (max 200)"
        },
        "discoveryAlerts": {
          "type": "array",
          "description": "Content discovery trend alerts (max 100)"
        },
        "youtubeChannels": {
          "type": "array",
          "description": "Connected workspace-scoped YouTube channels (max 100)"
        },
        "youtubeVideos": {
          "type": "array",
          "description": "YouTube video pipelines, scripts, metadata, and playlists (max 200)"
        },
        "seoArticles": {
          "type": "array",
          "description": "AI SEO blog articles and schema FAQ metadata (max 150)"
        },
        "cmsConnectors": {
          "type": "array",
          "description": "Direct CMS publishing connectors (max 50)"
        },
        "rssSources": {
          "type": "array",
          "description": "RSS, YouTube, and blog automation sources (max 150)"
        },
        "curatedItems": {
          "type": "array",
          "description": "Discovered viral posts and imported RSS items (max 200)"
        },
        "ecommerceFeeds": {
          "type": "array",
          "description": "Shopify and WooCommerce product feeds (max 50)"
        },
        "viralCampaigns": {
          "type": "array",
          "description": "Viral giveaways, UGC contests, and referral campaigns (max 100)"
        },
        "workspaceCredits": {
          "type": "object",
          "description": "Workspace-scoped AI credit consumption map"
        },
        "approvalAuditLogs": {
          "type": "array",
          "description": "Post approval queue audit trail (max 200)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "activeWorkspaceId",
        "activeRole",
        "selectedPlan",
        "darkMode",
        "workspaces",
        "categories",
        "connectedProfiles",
        "teamMembers",
        "contacts",
        "threads",
        "deals",
        "posts",
        "ads",
        "drafts",
        "discoveryAlerts",
        "youtubeChannels",
        "youtubeVideos",
        "seoArticles",
        "cmsConnectors",
        "rssSources",
        "curatedItems",
        "ecommerceFeeds",
        "viralCampaigns",
        "workspaceCredits",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Authoritative Super Admin registry entry",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "PlatformAdminState": {
      "title": "PlatformAdminState",
      "description": "Super Admin SaaS governance state (tenants, feature flags, AI governance, promos, invoices, audit logs)",
      "type": "object",
      "properties": {
        "updatedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenants": {
          "type": "array",
          "description": "Registered tenant accounts (max 200)"
        },
        "featureFlags": {
          "type": "array",
          "description": "Global platform feature flags (max 50)"
        },
        "auditLogs": {
          "type": "array",
          "description": "Admin audit trail (max 200)"
        },
        "apiHealthNodes": {
          "type": "array",
          "description": "Social API gateway health nodes (max 30)"
        },
        "aiGovernance": {
          "type": "object",
          "description": "AI Copilot governance configuration"
        },
        "promoCodes": {
          "type": "array",
          "description": "Active billing promo codes (max 100)"
        },
        "invoices": {
          "type": "array",
          "description": "Platform invoice ledger (max 200)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "updatedBy",
        "tenants",
        "featureFlags",
        "auditLogs",
        "apiHealthNodes",
        "aiGovernance",
        "promoCodes",
        "invoices",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformGovernanceConfig": {
      "title": "PlatformGovernanceConfig",
      "description": "Non-PII global AI model routing, per-plan module quotas, and feature flags readable by authenticated workspaces and writable only by Super Admin",
      "type": "object",
      "properties": {
        "updatedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "aiGovernance": {
          "type": "object",
          "description": "Global AI governance settings and per-plan module quotas"
        },
        "featureFlags": {
          "type": "array",
          "description": "Global platform feature flags (max 50)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["updatedBy", "aiGovernance", "featureFlags", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Workspace team member with role-based publishing and approval permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "role": { "type": "string", "enum": ["Owner", "Admin", "Editor", "Client Approver", "Manager", "Publisher", "Contributor"] },
        "status": { "type": "string", "enum": ["active", "invited"] },
        "permissions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "workspaceId", "name", "email", "role", "status", "createdAt", "updatedAt"]
    },
    "SocialConnection": {
      "title": "SocialConnection",
      "description": "Connected social media network profile metadata scoped to a workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "platform": { "type": "string", "maxLength": 32 },
        "accountName": { "type": "string", "maxLength": 160 },
        "handle": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["connected", "needs_reauth", "disconnected"] },
        "authMethod": { "type": "string", "enum": ["oauth2", "app_password", "manual"] },
        "followers": { "type": "number" },
        "lastSynced": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "workspaceId", "platform", "accountName", "handle", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile keyed by Firebase Auth UID"
    },
    "/users/{userId}/workspaces/{workspaceDocId}": {
      "schema": { "$ref": "#/entities/WorkspaceSnapshot" },
      "description": "User-owned cloud-synced workspace snapshot"
    },
    "/users/{userId}/workspaces/{workspaceDocId}/workspaceMembers/{memberId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Workspace-scoped team members and role permissions"
    },
    "/users/{userId}/workspaces/{workspaceDocId}/socialConnections/{connectionId}": {
      "schema": { "$ref": "#/entities/SocialConnection" },
      "description": "Workspace-scoped OAuth and App Password social connections"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Authoritative Super Admin role registry"
    },
    "/adminState/{configId}": {
      "schema": { "$ref": "#/entities/PlatformAdminState" },
      "description": "Super Admin SaaS platform configuration and tenant directory"
    },
    "/platformConfig/{configId}": {
      "schema": { "$ref": "#/entities/PlatformGovernanceConfig" },
      "description": "Non-PII global quotas and feature flags propagated from Super Admin to customer workspaces"
    }
  }
}
